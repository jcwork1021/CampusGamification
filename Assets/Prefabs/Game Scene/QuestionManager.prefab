  _multipleChoiceHandler: {fileID: 6233388979212397837}
  _trueFalseHandler: {fileID: 8810212275617417767}
  jsonToDeserialize: "{\r\n  \"id\": \"clx_quiz_01\",\r\n  \"title\": \"Intro Biology
    Quiz\",\r\n  \"description\": \"Quick check on cells and photosynthesis\",\r\n 
    \"pointsReward\": 50,\r\n  \"timeType\": \"DURATION\",\r\n  \"timeLimitMinutes\":
    15,\r\n  \"passingScore\": 70,\r\n  \"attemptLimit\": 3,\r\n  \"shuffleQuestions\":
    true,\r\n  \"shuffleOptions\": false,\r\n  \"showAnswersAfterCompletion\": true,\r\n 
    \"isPublished\": true,\r\n  \"questionCount\": 2,\r\n  \"questions\": [\r\n   
    {\r\n      \"id\": \"clx_q_mc\",\r\n      \"type\": \"MULTIPLE_CHOICE\",\r\n     
    \"text\": \"What is the powerhouse of the cell?\",\r\n      \"points\": 1,\r\n     
    \"explanation\": \"Mitochondria produce ATP.\",\r\n      \"options\": [\r\n       
    { \"id\": \"clx_opt_a\", \"content\": \"Nucleus\", \"isCorrect\": false },\r\n       
    { \"id\": \"clx_opt_b\", \"content\": \"Mitochondria\", \"isCorrect\": true },\r\n       
    { \"id\": \"clx_opt_c\", \"content\": \"Ribosome\", \"isCorrect\": false }\r\n     
    ]\r\n    },\r\n    {\r\n      \"id\": \"clx_q_tf\",\r\n      \"type\": \"TRUE_FALSE\",\r\n     
    \"text\": \"Photosynthesis occurs in the chloroplast.\",\r\n      \"points\":
    1,\r\n      \"options\": [\r\n        { \"id\": \"clx_opt_t\", \"content\": \"True\",
    \"isCorrect\": true },\r\n        { \"id\": \"clx_opt_f\", \"content\": \"False\",
    \"isCorrect\": false }\r\n      ]\r\n    }\r\n  ]\r\n}"
